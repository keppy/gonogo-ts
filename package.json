{
  "name": "gonogo-eval",
  "version": "0.1.0",
  "description": "TypeScript port of gonogo's decision core: decide and compare, pinned to the Python implementation by a fixture table.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "engines": { "node": ">=22.18" },
  "gonogo": { "pinnedTo": "0.4.4" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test 'test/*.test.ts'",
    "gen-fixtures": "node scripts/gen-fixtures.mjs fixtures",
    "check-fixtures": "node scripts/check-fixtures.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "~5.9.3"
  }
}
